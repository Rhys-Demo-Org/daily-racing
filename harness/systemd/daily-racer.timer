# Fires the nightly run at 02:00 London. Persistent=false: the VM runs in UTC and a missed run
# must never fire at boot in the daytime (daily.sh also refuses to start after 03:00 London).
[Unit]
Description=Daily AI Racer nightly run at 02:00 Europe/London

[Timer]
OnCalendar=*-*-* 02:00:00 Europe/London
Persistent=false
AccuracySec=1min
Unit=daily-racer.service

[Install]
WantedBy=timers.target
