# Nightly harness settings (HANDOVER §6.1, §8). Owner-maintained: only the owner edits this file.
# Sourced by bash and parsed by harness/lib/config.ts: plain KEY=value lines, no spaces around
# '=', no quotes needed; $HOME / ${HOME} are expanded, nothing else is.

# London schedule. The timer fires at START_AT; daily.sh refuses to start at or after
# START_CUTOFF, starts no phase or retry after NO_NEW_PHASE_AFTER and is killed at HARD_DEADLINE.
# A --manual run keeps the same offsets from its own start time (START_AT -> start).
TZ_NAME=Europe/London
START_AT=02:00
START_CUTOFF=03:00
NO_NEW_PHASE_AFTER=05:15
HARD_DEADLINE=06:30

# Pre-flight: minimum free disk under DAILY_HOME; open `daily` PRs that pause the loop (live mode).
MIN_FREE_DISK_GB=10
MAX_OPEN_DAILY_PRS=7

# Models, passed explicitly with --model.
MODEL_IDEATE=claude-opus-5-5
MODEL_BUILD=claude-opus-5-5
MODEL_JUDGE=claude-opus-5-5

# Per-phase limits: --max-turns and wall clock in minutes (each retry gets the retry limits).
MAX_TURNS_IDEATE=15
MAX_TURNS_BUILD=60
MAX_TURNS_RETRY=25
WALL_IDEATE_MIN=10
WALL_BUILD_MIN=75
WALL_RETRY_MIN=30
MAX_RETRIES=2
# --max-budget-usd per claude -p call: an extra brake (cost is notional on subscription auth).
MAX_BUDGET_USD=40

# Gates: wall-clock cap for one full gate run, and the bot-lap seeds (G2).
GATE_CAP_MIN=20
BOT_SEEDS=1,2,3,42,1234

# Hosts the agent sandbox proxy lets through (comma-separated).
PROXY_ALLOW=api.anthropic.com

# VM-side state, outside any repo: STOP file, dry-run ledger, token, clone (repo/), run logs (runs/).
DAILY_HOME=$HOME/.daily-racer
TOKEN_FILE=$HOME/.daily-racer/oauth-token
# Local daily/* branches in the clone older than this are deleted at the end of a run.
BRANCH_KEEP_DAYS=14
