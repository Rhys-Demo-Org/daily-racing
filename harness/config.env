# Nightly harness settings (HANDOVER §6.1, §8). Owner-maintained: only the owner edits this file.
# Sourced by bash (harness/lib/common.sh) and handed to harness/lib/cli.ts as a docker --env-file:
# plain KEY=value lines, no spaces around '=', no quotes. Docker takes values literally, so keys
# the TS side reads must not use $ expansions.

# London schedule. The timer fires at START_AT; daily.sh refuses to start after the START_CUTOFF
# minute, starts no new optional phase after NO_NEW_PHASE_AFTER (see the per-phase limits below) and
# is killed at HARD_DEADLINE.
# A --manual run keeps the same offsets from its own start time (START_AT -> start).
TZ_NAME=Europe/London
START_AT=02:00
START_CUTOFF=03:00
NO_NEW_PHASE_AFTER=05:15
HARD_DEADLINE=06:30

# Pre-flight: minimum free disk under DAILY_HOME; open `daily` PRs that pause the loop (live mode).
MIN_FREE_DISK_GB=10
MAX_OPEN_DAILY_PRS=7

# Models, passed explicitly with --model (plans/full-pipeline.md: every phase is its own agent).
# Reviewer R2 is the model-diversity trial (owner, 2026-11-02): Sonnet at max effort, kept or
# dropped on the evals. EFFORT_* is claude --effort; empty means the CLI default.
MODEL_IDEATE=claude-opus-5-5
MODEL_AUDIT=claude-opus-5-5
MODEL_BUILD=claude-opus-5-5
MODEL_REVIEW=claude-opus-5-5
MODEL_REVIEW_R2=claude-sonnet-5-5
EFFORT_REVIEW_R2=max
MODEL_VERIFY=claude-opus-5-5
MODEL_FIX=claude-opus-5-5
MODEL_JUDGE=claude-opus-5-5

# Per-phase limits: --max-turns and wall clock in minutes (each retry gets the retry limits).
# Every call's wall clock is also clipped so a gate run still fits before HARD_DEADLINE. After
# NO_NEW_PHASE_AFTER no ideate, audit, build, retry, review, fix or judge fix round starts (an
# unbuilt night aborts; a built one skips what is left of review and fixes, and the PR then says
# "Not reviewed" if the review never ran). Verification, gates and the judge are never dropped: they
# run while a call still fits before HARD_DEADLINE.
MAX_TURNS_IDEATE=15
MAX_TURNS_AUDIT=25
MAX_TURNS_BUILD=60
MAX_TURNS_RETRY=25
MAX_TURNS_REVIEW=60
MAX_TURNS_VERIFY=80
MAX_TURNS_FIX=40
MAX_TURNS_JUDGE=50
WALL_IDEATE_MIN=10
WALL_AUDIT_MIN=10
WALL_BUILD_MIN=75
WALL_RETRY_MIN=30
WALL_REVIEW_MIN=20
WALL_VERIFY_MIN=30
WALL_FIX_MIN=20
WALL_JUDGE_MIN=15
MAX_RETRIES=2
# Plan audit: revise rounds per item (each a fresh ideate, then a fresh auditor) and backlog items
# tried per night (defer or reject moves on to the next). Fix agents per night (one per verified
# finding, most severe first). Screenshot script wall clock.
MAX_AUDIT_REVISIONS=2
MAX_ITEMS_PER_NIGHT=2
MAX_FIXES=8
SCREENSHOT_MIN=10
# --max-budget-usd per claude -p call: an extra brake (cost is notional on subscription auth).
MAX_BUDGET_USD=40

# Gates: wall-clock cap for one full gate run, and the bot-lap seeds (G2).
GATE_CAP_MIN=20
BOT_SEEDS=1,2,3,42,1234

# Hosts the agent sandbox proxy lets through (comma-separated).
PROXY_ALLOW=api.anthropic.com

# VM-side state, outside any repo: STOP file, dry-run ledger, token, clone (repo/), run logs
# (runs/), install cache (cache/). An exported DAILY_HOME wins (tests use a scratch one).
DAILY_HOME=${DAILY_HOME:-$HOME/.daily-racer}
TOKEN_FILE=${TOKEN_FILE:-$DAILY_HOME/oauth-token}
# Local daily/* branches and cached installs unused for this many days are deleted after a run.
KEEP_DAYS=14
# One metrics row per night (plans/full-pipeline.md "Measuring it").
METRICS_CSV=${METRICS_CSV:-$DAILY_HOME/metrics.csv}
# The owner's GitHub login: the only account whose PR text reaches the existing-work list, and the
# reviewer requested on each PR. Harness posts carry <!-- daily-racer:harness --> until the App exists.
OWNER_LOGIN=rhyscharris
# Live mode: fine-grained PAT for this repo only (Contents, Pull requests, Issues: write; no
# Workflows), used on the host by harness/scripts/publish.sh and the pre-flight PR count.
GITHUB_TOKEN_FILE=${GITHUB_TOKEN_FILE:-$DAILY_HOME/github-token}
